# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# MYKET_PUBLIC_KEY: مایکت - کلید عمومی احراز هویت پرداخت درون‌برنامه‌ای
MYKET_PUBLIC_KEY=MY_MYKET_PUBLIC_KEY_PLACEHOLDER

# TAVANA_AUTOMATION_API_KEY: کلید API اتوماسیون و سرور
TAVANA_AUTOMATION_API_KEY=MY_AUTOMATION_API_KEY_PLACEHOLDER
